<Window x:Class="Windows_Server_Tools.CommonlyInstalledWindowsComponents"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Windows_Server_Tools"
        mc:Ignorable="d"
        Title="Commonly installed Windows components"
        Icon="Assets/windows-server-setupper.ico"
        Height="450"
        Width="800"
        MinHeight="260"
        MinWidth="340"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="160" MinWidth="520">
        <Image x:Name="AppLogoImage" Source="Assets/windows-server-setupper-logo-master.png" AutomationProperties.Name="Current application logo" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="48" Height="48" Margin="0,0,12,12" Stretch="Uniform"/>
        <Button x:Name="IIS" Content="IIS" AutomationProperties.Name="Install IIS and all of its components" AutomationProperties.HelpText="Installs IIS and verifies the requested Windows feature state." HorizontalAlignment="Left" Height="29" Margin="27,23,0,0" VerticalAlignment="Top" Width="219" Click="IIS_Click"/>
        <Button x:Name="FileAndStorage" Content="File and Storage Services" AutomationProperties.Name="Install File and Storage Services" AutomationProperties.HelpText="Installs and verifies the requested File and Storage Services features." HorizontalAlignment="Left" Height="29" Margin="263,23,0,0" VerticalAlignment="Top" Width="240" Click="FileAndStorage_Click"/>
            </Grid>
        </ScrollViewer>

        <Border x:Name="OperationStatusPanel"
                Visibility="Collapsed"
                AutomationProperties.Name="Server feature operation status panel"
                KeyboardNavigation.TabNavigation="Local"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                MaxWidth="520"
                MaxHeight="280"
                Margin="16,16,16,64"
                Padding="16"
                CornerRadius="12"
                Background="#FF2E2E2E"
                BorderBrush="#FF777777"
                BorderThickness="1"
                GotKeyboardFocus="OperationStatusPanel_GotKeyboardFocus">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel x:Name="OperationNavigationPanel" Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                    <Button x:Name="PreviousOperationButton"
                            DockPanel.Dock="Left"
                            Content="Previous"
                            MinWidth="88"
                            MinHeight="36"
                            Margin="0,0,8,0"
                            AutomationProperties.HelpText="Shows the previous pending server feature action."
                            Click="PreviousOperationButton_Click"/>
                    <Button x:Name="NextOperationButton"
                            DockPanel.Dock="Right"
                            Content="Next"
                            MinWidth="88"
                            MinHeight="36"
                            Margin="8,0,0,0"
                            AutomationProperties.HelpText="Shows the next pending server feature action."
                            Click="NextOperationButton_Click"/>
                    <TextBlock x:Name="OperationPositionText"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="White"
                               AutomationProperties.LiveSetting="Polite"
                               Text="Pending action 1 of 1"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1"
                               VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="True"
                              AutomationProperties.Name="Server feature operation details">
                    <TextBlock x:Name="OperationStatusText"
                               AutomationProperties.LiveSetting="Assertive"
                               Foreground="White"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
                <WrapPanel Grid.Row="2"
                           HorizontalAlignment="Stretch"
                           Margin="0,12,0,0">
                    <Button x:Name="RetryOperationButton"
                            AutomationProperties.HelpText="Retries the failed server feature action."
                            MinHeight="36"
                            MaxWidth="240"
                            HorizontalContentAlignment="Center"
                            Margin="0,0,8,4"
                            Click="RetryOperationButton_Click">
                        <TextBlock x:Name="RetryOperationButtonText"
                                   Text="Retry failed action"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Button>
                    <Button x:Name="DismissOperationButton"
                            Content="Dismiss"
                            AutomationProperties.HelpText="Hides this notification and returns focus to the originating control."
                            MinHeight="36"
                            Margin="0,0,0,4"
                            Click="DismissOperationButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Button x:Name="ReviewPendingActionsButton"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                MinHeight="36"
                MaxWidth="280"
                HorizontalContentAlignment="Center"
                Margin="16"
                AutomationProperties.HelpText="Opens the pending server feature actions without starting them."
                Click="ReviewPendingActionsButton_Click">
            <TextBlock x:Name="ReviewPendingActionsButtonText"
                       Text="Review pending actions"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Button>

    </Grid>
</Window>
