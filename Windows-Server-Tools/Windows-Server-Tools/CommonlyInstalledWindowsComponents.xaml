<Window x:Class="Windows_Server_Tools.CommonlyInstalledWindowsComponents"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Windows_Server_Tools"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Commonly installed Windows components"
        Icon="Assets/windows-server-setupper.ico"
        Height="450"
        Width="800"
        MinHeight="260"
        MinWidth="340"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FFFFF7FF"
        Loaded="Window_Loaded"
        KeyboardNavigation.TabNavigation="Continue"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="#FF21005D"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="TitleBarLogoImage"
                       Grid.Column="0"
                       Width="32"
                       Height="32"
                       Margin="10,8"
                       Stretch="Uniform"
                       IsHitTestVisible="False"
                       AutomationProperties.Name="Current application logo"/>
                <TextBlock Grid.Column="1"
                           Text="Commonly installed server features"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"/>
                <Button Grid.Column="2" MinWidth="44" MinHeight="44" Content="—" Foreground="White" Background="Transparent" BorderThickness="0" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize window" Click="MinimizeWindowButton_Click"/>
                <Button Grid.Column="3" MinWidth="44" MinHeight="44" Content="□" Foreground="White" Background="Transparent" BorderThickness="0" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximize or restore window" Click="MaximizeRestoreWindowButton_Click"/>
                <Button Grid.Column="4" MinWidth="44" MinHeight="44" Content="×" Foreground="White" Background="Transparent" BorderThickness="0" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close window" Click="CloseWindowButton_Click"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      KeyboardNavigation.TabNavigation="Continue">
            <StackPanel Margin="16" MaxWidth="720">
                <DockPanel LastChildFill="True" Margin="0,0,0,12">
                    <Image x:Name="AppLogoImage"
                           Source="Assets/windows-server-setupper-logo-master.png"
                           AutomationProperties.Name="Current application logo"
                           DockPanel.Dock="Left"
                           Width="48"
                           Height="48"
                           Margin="0,0,12,0"
                           Stretch="Uniform"/>
                    <StackPanel>
                        <TextBlock Text="Commonly installed server features"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Commonly installed server features heading"/>
                        <TextBlock Text="Choose one feature group. The app reports real progress and preserves a retry route when a server command does not complete."
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
                <WrapPanel>
                    <Button x:Name="IIS"
                            MinWidth="220"
                            MinHeight="44"
                            Padding="12,6"
                            Margin="0,0,8,8"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="Install IIS and all of its components"
                            AutomationProperties.HelpText="Installs IIS and verifies the requested Windows feature state."
                            Click="IIS_Click">
                        <TextBlock Text="Install IIS and components" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>
                    <Button x:Name="FileAndStorage"
                            MinWidth="220"
                            MinHeight="44"
                            Padding="12,6"
                            Margin="0,0,8,8"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="Install File and Storage Services"
                            AutomationProperties.HelpText="Installs and verifies the requested File and Storage Services features."
                            Click="FileAndStorage_Click">
                        <TextBlock Text="Install File and Storage Services" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>
                </WrapPanel>
                <TextBlock Margin="0,8,0,72"
                           Text="Only one server-changing operation can run at a time. Disabled actions identify the active operation in their accessible help text."
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="OperationStatusPanel"
                Visibility="Collapsed"
                AutomationProperties.Name="Server feature operation status panel"
                KeyboardNavigation.TabNavigation="Local"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                MaxWidth="520"
                MaxHeight="280"
                Margin="16,16,16,64"
                Padding="16"
                CornerRadius="12"
                Background="#FF2E2E2E"
                BorderBrush="#FF777777"
                BorderThickness="1"
                GotKeyboardFocus="OperationStatusPanel_GotKeyboardFocus">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel x:Name="OperationNavigationPanel" Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                    <Button x:Name="PreviousOperationButton"
                            DockPanel.Dock="Left"
                            Content="Previous"
                            MinWidth="88"
                            MinHeight="44"
                            Margin="0,0,8,0"
                            AutomationProperties.HelpText="Shows the previous pending server feature action."
                            Click="PreviousOperationButton_Click"/>
                    <Button x:Name="NextOperationButton"
                            DockPanel.Dock="Right"
                            Content="Next"
                            MinWidth="88"
                            MinHeight="44"
                            Margin="8,0,0,0"
                            AutomationProperties.HelpText="Shows the next pending server feature action."
                            Click="NextOperationButton_Click"/>
                    <TextBlock x:Name="OperationPositionText"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="White"
                               AutomationProperties.LiveSetting="Polite"
                               Text="Pending action 1 of 1"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1"
                               VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="True"
                              AutomationProperties.Name="Server feature operation details">
                    <TextBlock x:Name="OperationStatusText"
                               AutomationProperties.LiveSetting="Assertive"
                               Foreground="White"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
                <WrapPanel Grid.Row="2"
                           HorizontalAlignment="Stretch"
                           Margin="0,12,0,0">
                    <Button x:Name="RetryOperationButton"
                            AutomationProperties.HelpText="Retries the failed server feature action."
                            MinHeight="44"
                            MaxWidth="240"
                            HorizontalContentAlignment="Center"
                            Margin="0,0,8,4"
                            Click="RetryOperationButton_Click">
                        <TextBlock x:Name="RetryOperationButtonText"
                                   Text="Retry failed action"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Button>
                    <Button x:Name="DismissOperationButton"
                            Content="Dismiss"
                            AutomationProperties.HelpText="Hides this notification and returns focus to the originating control."
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="DismissOperationButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Button x:Name="ReviewPendingActionsButton"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                MinHeight="44"
                MaxWidth="280"
                HorizontalContentAlignment="Center"
                Margin="16"
                AutomationProperties.HelpText="Opens the pending server feature actions without starting them."
                Click="ReviewPendingActionsButton_Click">
            <TextBlock x:Name="ReviewPendingActionsButtonText"
                       Text="Review pending actions"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Button>

        </Grid>
    </Grid>
</Window>
