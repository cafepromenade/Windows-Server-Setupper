<Window x:Class="Windows_Server_Tools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Windows_Server_Tools"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Windows Server Tools"
        Icon="Assets/windows-server-setupper.ico"
        Width="760"
        Height="580"
        MinWidth="360"
        MinHeight="300"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FFFFF7FF"
        d:DesignHeight="557.713"
        d:DesignWidth="747.722"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="#FF21005D"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="TitleBarLogoImage"
                       Grid.Column="0"
                       Width="32"
                       Height="32"
                       Margin="10,8"
                       Stretch="Uniform"
                       IsHitTestVisible="False"
                       AutomationProperties.Name="Current application logo"/>
                <TextBlock Grid.Column="1"
                           Text="Windows Server Tools"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"/>
                <Button Grid.Column="2"
                        MinWidth="44"
                        MinHeight="44"
                        Content="—"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Minimize window"
                        Click="MinimizeWindowButton_Click"/>
                <Button Grid.Column="3"
                        MinWidth="44"
                        MinHeight="44"
                        Content="□"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Maximize or restore window"
                        Click="MaximizeRestoreWindowButton_Click"/>
                <Button Grid.Column="4"
                        MinWidth="44"
                        MinHeight="44"
                        Content="×"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Close window"
                        Click="CloseWindowButton_Click"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
        <ScrollViewer x:Name="MainContentScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      KeyboardNavigation.TabNavigation="Continue">
            <StackPanel Margin="16" MaxWidth="720">
                <Border Padding="16" Margin="0,0,0,12" Background="#FFE8DEF8" CornerRadius="16">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Image x:Name="AppLogoImage"
                                   Source="Assets/windows-server-setupper-logo-master.png"
                                   Width="48"
                                   Height="48"
                                   Margin="0,0,12,0"
                                   Stretch="Uniform"
                                   AutomationProperties.Name="Windows Server Tools server and mail logo"/>
                            <TextBlock Text="Initial server setup"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Margin="0,6,0,12"
                                   Text="Startup is read-only. Review the exact network, security, role, and software changes before authorizing this setup."
                                   TextWrapping="Wrap"/>
                        <WrapPanel>
                            <Button x:Name="ReviewInitialSetupButton"
                                    MinHeight="44"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    Content="Review initial server setup plan…"
                                    AutomationProperties.Name="Review the initial server setup plan"
                                    AutomationProperties.HelpText="Opens the two-key confirmation without changing this server."
                                    Click="ReviewInitialSetupButton_Click"/>
                            <Button x:Name="CheckForUpdatesButton"
                                    MinHeight="44"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    Content="Check for updates"
                                    AutomationProperties.Name="Check for application updates"
                                    AutomationProperties.HelpText="Checks the configured HTTPS manifest for an unsigned update."
                                    Click="CheckForUpdatesButton_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <GroupBox Header="Appearance and application logo" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Image x:Name="LogoPreviewImage"
                                   DockPanel.Dock="Left"
                                   Width="64"
                                   Height="64"
                                   Margin="0,0,12,0"
                                   Stretch="Uniform"
                                   AutomationProperties.Name="Current application logo preview"/>
                            <StackPanel>
                                <TextBlock Text="Application logo preset" TextWrapping="Wrap"/>
                                <ComboBox x:Name="LogoPresetComboBox"
                                          MinHeight="44"
                                          Margin="0,4,0,8"
                                          AutomationProperties.Name="Application logo preset"
                                          SelectionChanged="LogoPresetComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Server and mail mark" Tag="master"/>
                                    <ComboBoxItem Content="Compact application icon" Tag="icon"/>
                                    <ComboBoxItem Content="Local custom image" Tag="custom"/>
                                </ComboBox>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="Custom images are processed only on this computer. Choose PNG, JPEG, or BMP up to 5 MiB, 4096 pixels per side, 16 megapixels, and one frame. The app stores private validated cache files, never the source path." TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="ChooseCustomLogoButton"
                                    Content="Choose local image…"
                                    MinHeight="44"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    AutomationProperties.Name="Choose a local custom application logo image"
                                    Click="ChooseCustomLogoButton_Click"/>
                            <Button x:Name="ResetLogoButton"
                                    Content="Reset to shipped logo"
                                    MinHeight="44"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    Click="ResetLogoButton_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Fit behavior" TextWrapping="Wrap"/>
                        <ComboBox x:Name="LogoFitComboBox"
                                  MinHeight="44"
                                  Margin="0,4,0,8"
                                  AutomationProperties.Name="Custom logo fit behavior">
                            <ComboBoxItem Content="Contain — show the complete image" Tag="contain" IsSelected="True"/>
                            <ComboBoxItem Content="Fill — crop to the square using the focal point" Tag="fill"/>
                        </ComboBox>
                        <TextBlock Text="Background: transparent or #AARRGGBB" TextWrapping="Wrap"/>
                        <TextBox x:Name="LogoBackgroundTextBox"
                                 Text="transparent"
                                 MinHeight="40"
                                 Margin="0,4,0,8"
                                 AutomationProperties.Name="Custom logo background color"/>
                        <TextBlock Text="Horizontal focal point (0 left, 100 right)" TextWrapping="Wrap"/>
                        <Slider x:Name="LogoFocalXSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="50"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                MinHeight="44"
                                AutomationProperties.Name="Custom logo horizontal focal point"/>
                        <TextBlock Text="Vertical focal point (0 top, 100 bottom)" TextWrapping="Wrap"/>
                        <Slider x:Name="LogoFocalYSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="50"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                MinHeight="44"
                                AutomationProperties.Name="Custom logo vertical focal point"/>
                        <Button x:Name="ApplyLogoRenderingButton"
                                Content="Apply custom rendering"
                                MinHeight="44"
                                Padding="12,6"
                                Margin="0,8,0,0"
                                Click="ApplyLogoRenderingButton_Click"/>
                        <TextBlock x:Name="LogoStatusText"
                                   Margin="0,8,0,0"
                                   Text="The shipped server-and-mail logo is active."
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Active Directory and network" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="New domain name" TextWrapping="Wrap"/>
                        <TextBox x:Name="DomainNameTextBox"
                                 AutomationProperties.Name="New domain name"
                                 MinHeight="40"
                                 Margin="0,4,0,10"
                                 TextWrapping="Wrap"
                                 TextChanged="UpdateUnsavedStateChanged"/>
                        <TextBlock Text="Directory Services Restore Mode password" TextWrapping="Wrap"/>
                        <PasswordBox x:Name="SafeModePasswordBox"
                                     AutomationProperties.Name="Directory Services Restore Mode password"
                                     MinHeight="40"
                                     Margin="0,4,0,12"
                                     PasswordChanged="UpdateUnsavedStateChanged"/>
                        <WrapPanel>
                            <Button x:Name="InstallActiveDirectoryButton"
                                    Content="Install Active Directory"
                                    AutomationProperties.Name="Install Active Directory and promote this server"
                                    AutomationProperties.HelpText="Installs Active Directory Domain Services and promotes this server after validating the domain and protected password fields."
                                    MinHeight="44"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    Click="InstallActiveDirectoryButton_Click"/>
                            <Button x:Name="SetStaticIpButton"
                                    Content="Set Static IP"
                                    AutomationProperties.Name="Set the current network address as static"
                                    AutomationProperties.HelpText="Sets the current network address as static."
                                    MinHeight="44"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    Click="Button_Click"/>
                            <Button x:Name="AdapterSettingsButton"
                                    Content="Network Adapter Settings"
                                    AutomationProperties.Name="Open network adapter settings"
                                    AutomationProperties.HelpText="Opens the system Network Connections control panel."
                                    MinHeight="44"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    Click="Button_Click_2"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Directory users and shared folders" Padding="12" Margin="0,0,0,12">
                    <Button x:Name="SimpsonsSetupButton"
                            Content="Import users, spread accounts, create groups, and create shared folders"
                            AutomationProperties.Name="Run the Simpsons directory, group, and shared-folder setup"
                            AutomationProperties.HelpText="Runs the resumable Simpsons directory, user, group, and shared-folder setup."
                            MinHeight="44"
                            Padding="12,6"
                            HorizontalContentAlignment="Left"
                            Click="Button_Click_1"/>
                </GroupBox>

                <GroupBox Header="Software installation" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Chocolatey packages to install" TextWrapping="Wrap"/>
                        <TextBox x:Name="ChocoSoftwareTextBox"
                                 AutomationProperties.Name="Chocolatey packages to install"
                                 MinHeight="64"
                                 Margin="0,4,0,10"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 TextChanged="UpdateUnsavedStateChanged"/>
                        <WrapPanel>
                            <Button x:Name="InstallChocolateyButton"
                                    Content="Install Chocolatey"
                                    AutomationProperties.Name="Install Chocolatey"
                                    AutomationProperties.HelpText="Installs Chocolatey when no other server change is running."
                                    MinHeight="44"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    Click="InstallChocolateyButton_Click"/>
                            <Button x:Name="InstallChocolateySoftwareButton"
                                    Content="Install selected software"
                                    AutomationProperties.Name="Install the selected Chocolatey software"
                                    AutomationProperties.HelpText="Installs the validated package names entered above when no other server change is running."
                                    MinHeight="44"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    Click="InstallChocolateySoftwareButton_Click"/>
                        </WrapPanel>
                        <TextBlock Margin="0,10,0,6" Text="Server-role installers" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <WrapPanel>
                            <Button x:Name="OmegaServerPromoteButton"
                                    Content="Promote to Omega Server"
                                    MinHeight="44"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    IsEnabled="False"
                                    ToolTip="Unavailable until a credential-safe Omega Server installer is published and pinned."
                                    ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.HelpText="Unavailable until a credential-safe Omega Server installer is published and pinned."/>
                            <Button x:Name="SCCMButton"
                                    Content="SCCM Only"
                                    MinHeight="44"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    IsEnabled="False"
                                    Click="SCCMButton_Click"
                                    ToolTip="Unavailable until a credential-safe SCCM installer is published and pinned."
                                    ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.HelpText="Unavailable until a credential-safe SCCM installer is published and pinned."/>
                            <Button x:Name="SideServerButton"
                                    IsEnabled="False"
                                    Content="Install Side Server"
                                    MinHeight="44"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    ToolTip="Unavailable until a credential-safe Side Server installer is published and pinned."
                                    ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.HelpText="Unavailable until a credential-safe Side Server installer is published and pinned."/>
                        </WrapPanel>
                        <TextBlock Text="Server-role installers are unavailable until credential-safe builds are published and pinned."
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Server features" Padding="12" Margin="0,0,0,72">
                    <Button x:Name="CommonInstallStuffButton"
                            Content="Open commonly installed server features"
                            AutomationProperties.Name="Open commonly installed server features"
                            AutomationProperties.HelpText="Opens the IIS and File and Storage Services feature actions."
                            MinHeight="44"
                            Padding="12,6"
                            Click="CommonInstallStuffButton_Click"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="InitialSetupConfirmationPanel"
                Panel.ZIndex="30"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="680"
                MaxHeight="540"
                Margin="12"
                Padding="20"
                CornerRadius="20"
                Background="#FFFEF7FF"
                BorderBrush="#FF6750A4"
                BorderThickness="2"
                AutomationProperties.Name="Initial server setup destructive confirmation"
                KeyboardNavigation.TabNavigation="Cycle">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Review the exact initial server setup plan"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <ScrollViewer Grid.Row="1"
                              Margin="0,12"
                              MaxHeight="390"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="This one operation will make all of these administrator-level changes:"
                                   TextWrapping="Wrap"/>
                        <TextBlock Margin="12,8,0,0" Text="• Convert the active IPv4 adapter to its current static address, gateway, and DNS server." TextWrapping="Wrap"/>
                        <TextBlock Margin="12,4,0,0" Text="• Turn off every firewall profile and Microsoft Defender real-time monitoring." TextWrapping="Wrap"/>
                        <TextBlock Margin="12,4,0,0" Text="• Disable standby, display, disk, and hibernation timeouts on AC power." TextWrapping="Wrap"/>
                        <TextBlock Margin="12,4,0,0" Text="• Enable Remote Desktop, disable Network Level Authentication, disable SmartScreen, and restart Explorer." TextWrapping="Wrap"/>
                        <TextBlock Margin="12,4,0,0" Text="• Install and configure DNS and DHCP server roles and authorize DHCP in Active Directory." TextWrapping="Wrap"/>
                        <TextBlock Margin="12,4,0,0" Text="• Change the secure-attention sequence setting and install the pinned Chocolatey 2.7.3 package." TextWrapping="Wrap"/>
                        <TextBlock Margin="0,12,0,0"
                                   FontWeight="Bold"
                                   Foreground="#FFB3261E"
                                   Text="Security impact: firewall, Network Level Authentication, SmartScreen, and antivirus protections will be reduced or disabled. Review your organization’s policy and recovery access before continuing."
                                   TextWrapping="Wrap"/>
                        <CheckBox x:Name="InitialSetupKeyOneCheckBox"
                                  Margin="0,14,0,0"
                                  MinHeight="44"
                                  Content="Key 1 — I reviewed every network, security, role, and software change above."
                                  AutomationProperties.Name="Confirmation key one: reviewed every listed server change"
                                  Checked="InitialSetupConfirmationStateChanged"
                                  Unchecked="InitialSetupConfirmationStateChanged"/>
                        <CheckBox x:Name="InitialSetupKeyTwoCheckBox"
                                  Margin="0,6,0,0"
                                  MinHeight="44"
                                  Content="Key 2 — I have administrator access and a tested recovery route for this server."
                                  AutomationProperties.Name="Confirmation key two: administrator access and tested recovery route"
                                  Checked="InitialSetupConfirmationStateChanged"
                                  Unchecked="InitialSetupConfirmationStateChanged"/>
                        <TextBlock Margin="0,12,0,4"
                                   Text="After both keys are set, move the confirmation slider through its full 0–100 range."
                                   TextWrapping="Wrap"/>
                        <Slider x:Name="InitialSetupAuthorizationSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                SmallChange="5"
                                LargeChange="25"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                IsEnabled="False"
                                MinHeight="44"
                                AutomationProperties.Name="Initial setup confirmation slider from 0 to 100"
                                AutomationProperties.HelpText="The slider is enabled only after both independent confirmation keys are set."
                                ValueChanged="InitialSetupAuthorizationSlider_ValueChanged"/>
                        <ProgressBar x:Name="InitialSetupAuthorizationProgress"
                                     Margin="0,4,0,0"
                                     Height="12"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     AutomationProperties.Name="Initial setup authorization progress"/>
                        <TextBlock x:Name="InitialSetupConfirmationStatusText"
                                   Margin="0,8,0,0"
                                   Text="Set both independent confirmation keys to enable the slider."
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive"/>
                    </StackPanel>
                </ScrollViewer>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                    <Button x:Name="InitialSetupEmergencyExitButton"
                            Content="Emergency exit"
                            MinHeight="44"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            AutomationProperties.HelpText="Cancels without changing the server and returns focus to the review button."
                            Click="InitialSetupEmergencyExitButton_Click"/>
                    <Button x:Name="InitialSetupAuthorizeButton"
                            Content="Authorize and run initial setup"
                            MinHeight="44"
                            Padding="12,6"
                            IsEnabled="False"
                            AutomationProperties.HelpText="Runs exactly one reviewed initial-setup batch after both keys and the full slider are complete."
                            Click="InitialSetupAuthorizeButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border x:Name="UpdateStatusPanel"
                Panel.ZIndex="22"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Application update status"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                MaxWidth="520"
                MaxHeight="360"
                Margin="16"
                Padding="16"
                CornerRadius="12"
                Background="#FF1A4834"
                BorderBrush="#FF8ED6B4"
                BorderThickness="1"
                KeyboardNavigation.TabNavigation="Local">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="UpdateTitleText"
                           Grid.Row="0"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="16"
                           TextWrapping="Wrap"/>
                <ScrollViewer Grid.Row="1"
                              Margin="0,6,0,0"
                              MaxHeight="130"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="UpdateStatusText"
                               Foreground="White"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                </ScrollViewer>
                <ProgressBar x:Name="UpdateProgress"
                             Grid.Row="2"
                             Visibility="Collapsed"
                             Height="12"
                             Margin="0,10,0,0"
                             Minimum="0"
                             Maximum="100"
                             AutomationProperties.Name="Update download progress"/>
                <TextBlock x:Name="UpdateRestartReasonText"
                           Grid.Row="3"
                           Visibility="Collapsed"
                           Margin="0,8,0,0"
                           Foreground="White"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
                <WrapPanel Grid.Row="4" Margin="0,12,0,0" HorizontalAlignment="Right">
                    <Button x:Name="UpdateReleaseNotesButton"
                            Visibility="Collapsed"
                            Content="Release notes"
                            MinHeight="44"
                            Padding="12,6"
                            Margin="0,0,8,8"
                            AutomationProperties.HelpText="Opens the HTTPS release notes for the available version."
                            Click="UpdateReleaseNotesButton_Click"/>
                    <Button x:Name="UpdateCancelButton"
                            Visibility="Collapsed"
                            Content="Cancel download"
                            MinHeight="44"
                            Padding="12,6"
                            Margin="0,0,8,8"
                            Click="UpdateCancelButton_Click"/>
                    <Button x:Name="UpdateRestartButton"
                            Visibility="Collapsed"
                            Content="Restart to install update"
                            MinHeight="44"
                            Padding="12,6"
                            Margin="0,0,8,8"
                            Click="UpdateRestartButton_Click"/>
                    <Button x:Name="UpdateLaterButton"
                            Content="Later"
                            MinHeight="44"
                            Padding="12,6"
                            Margin="0,0,0,8"
                            AutomationProperties.HelpText="Hides this update status until the next scheduled or manual check."
                            Click="UpdateLaterButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Button x:Name="ReviewPendingRecoveryButton"
                Panel.ZIndex="19"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="16"
                MinWidth="180"
                MinHeight="36"
                Content="Review pending actions"
                AutomationProperties.HelpText="Reopens recovery actions that are still waiting to be retried."
                Click="ReviewPendingRecoveryButton_Click"/>

        <Border x:Name="RecoveryNotification"
                Panel.ZIndex="20"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="Operation status and recovery actions"
                KeyboardNavigation.TabNavigation="Local"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                MaxWidth="520"
                MaxHeight="320"
                Margin="16"
                Padding="16"
                CornerRadius="12"
                Background="#FF2E2E2E"
                BorderBrush="#FF777777"
                BorderThickness="1"
                Focusable="False"
                GotKeyboardFocus="RecoveryNotification_GotKeyboardFocus">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="RecoveryTitleText"
                           Grid.Row="0"
                           AutomationProperties.LiveSetting="Assertive"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="15"
                           TextWrapping="Wrap"/>
                <DockPanel x:Name="RecoveryNavigationPanel" Grid.Row="1" Margin="0,8,0,0" LastChildFill="True">
                    <Button x:Name="PreviousRecoveryButton"
                            DockPanel.Dock="Left"
                            Content="Previous"
                            MinWidth="88"
                            MinHeight="36"
                            Margin="0,0,8,0"
                            AutomationProperties.HelpText="Shows the previous pending recovery action."
                            Click="PreviousRecoveryButton_Click"/>
                    <Button x:Name="NextRecoveryButton"
                            DockPanel.Dock="Right"
                            Content="Next"
                            MinWidth="88"
                            MinHeight="36"
                            Margin="8,0,0,0"
                            AutomationProperties.HelpText="Shows the next pending recovery action."
                            Click="NextRecoveryButton_Click"/>
                    <TextBlock x:Name="RecoveryPositionText"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="White"
                               AutomationProperties.LiveSetting="Polite"
                               Text="Pending action 1 of 1"/>
                </DockPanel>
                <ScrollViewer Grid.Row="2"
                               Margin="0,6,0,12"
                              MaxHeight="130"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="True"
                              AutomationProperties.Name="Recovery details">
                    <StackPanel>
                        <TextBlock x:Name="RecoveryMessageText"
                                   AutomationProperties.LiveSetting="Assertive"
                                   Foreground="White"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="RecoverySupplementalText"
                                   Visibility="Collapsed"
                                   Foreground="White"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
                    <Button x:Name="RetryRecoveryButton"
                            Content="Retry failed action"
                            AutomationProperties.HelpText="Retries only the failed or incomplete action. Completed setup steps are preserved."
                            MinWidth="132"
                            MinHeight="36"
                            Margin="0,0,8,0"
                            Click="RetryRecoveryButton_Click"/>
                    <Button x:Name="MarkRecoveryCompletedButton"
                            Content="It completed — continue"
                            Visibility="Collapsed"
                            AutomationProperties.HelpText="Confirms that the uncertain action completed and was applied, then continues the remaining setup without replaying it."
                            MinWidth="150"
                            MinHeight="36"
                            Margin="0,0,8,0"
                            Click="MarkRecoveryCompletedButton_Click"/>
                    <Button x:Name="OpenRecoveryLogButton"
                            Content="Open error log"
                            AutomationProperties.HelpText="Opens the local diagnostic log folder."
                            MinWidth="108"
                            MinHeight="36"
                            Margin="0,0,8,0"
                            Click="OpenRecoveryLogButton_Click"/>
                    <Button x:Name="DismissRecoveryButton"
                            Content="Dismiss"
                            AutomationProperties.HelpText="Hides this notification without discarding resumable setup state."
                            MinWidth="82"
                            MinHeight="36"
                            Click="DismissRecoveryButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        </Grid>
    </Grid>
</Window>
