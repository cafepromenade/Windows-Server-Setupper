{
  "name": "exchange-auto-installer",
  "version": "1.0.0",
  "description": "A guided, resumable desktop installer for Microsoft Exchange Server",
  "main": "src/main.js",
  "author": "Windows Server Tools contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "clean": "node scripts/clean-dist.js",
    "prebuild": "npm run clean",
    "build": "electron-builder --dir --win --publish never",
    "prepackage": "npm run clean",
    "package": "electron-builder --win squirrel --publish never"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3"
  },
  "build": {
    "appId": "com.windowsservertools.exchangeautoinstaller",
    "productName": "Exchange Auto Installer",
    "artifactName": "ExchangeAutoInstaller-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "squirrel",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "signAndEditExecutable": false,
      "legalTrademarks": ""
    },
    "squirrelWindows": {
      "msi": false,
      "artifactName": "ExchangeAutoInstaller-${version}-${arch}-Setup.${ext}",
      "iconUrl": "https://raw.githubusercontent.com/cafepromenade/Windows-Server-Setupper/c95456bad91737dcd49bfcdb64e75dbd62885db3/Windows-Server-Tools/Exchange-Install-API/favicon.ico"
    }
  }
}
